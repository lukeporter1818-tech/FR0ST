generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DISPATCHER
  ADMIN
  TECHNICIAN
}

enum TechStatus {
  ACTIVE
  OFF
  VACATION
  SICK
}

enum JobType {
  SERVICE
  INSTALL
  MAINTENANCE
  CALLBACK
  EMERGENCY
  INSPECTION
  ESTIMATE
}

enum Trade {
  HVAC
  REFRIGERATION
  PLUMBING
  ELECTRICAL
  MULTI
  UNKNOWN
}

enum Priority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum JobStatus {
  NEW
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ScheduleStatus {
  SCHEDULED
  EN_ROUTE
  ON_SITE
  COMPLETED
  SKIPPED
}

enum SmsDirection {
  OUTBOUND
  INBOUND
}

// ── USERS & AUTH ──

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(TECHNICIAN)
  phone         String?
  active        Boolean   @default(true)
  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?
  inviteTokenHash  String?
  inviteExpiresAt  DateTime?
  isActivated      Boolean   @default(true)
  canManageStores  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  technician     Technician?
  chatMessages   ChatMessage[]
  notes          Note[]
  aiInteractions AIInteraction[]

  mgmtTasksCreated  ManagementTask[] @relation("MgmtTasksCreated")
  mgmtTasksAssigned ManagementTask[] @relation("MgmtTasksAssigned")
}

// ── TECHNICIANS ──

model Technician {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id])
  name      String
  phone     String
  status    TechStatus @default(ACTIVE)
  tradeType String?
  skillTags String[]
  notes     String?
  active      Boolean    @default(true)
  onSchedule  Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  scheduleEntries ScheduleEntry[]
  jobs            Job[]
  smsMessages     SmsMessage[]
  boardEntries    BoardEntry[]
}

// ── JOBS ──

model Job {
  id               String    @id @default(cuid())
  customerName     String
  customerPhone    String?
  address          String
  city             String?
  state            String?
  zip              String?
  issueDescription String
  jobType          JobType   @default(SERVICE)
  tradeClassification Trade?
  priority         Priority  @default(NORMAL)
  status           JobStatus @default(NEW)
  scheduledDate    DateTime?
  timeWindow       String?
  assignedTechId   String?
  assignedTech     Technician? @relation(fields: [assignedTechId], references: [id])
  dispatcherNotes  String?
  internalNotes    String?
  tags             String[]

  aiSummary           String?
  aiUrgency           String?
  aiTradeGuess        Trade?
  aiFollowUpQuestions String[]
  aiRiskFlags         String[]

  lat Float?
  lng Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleEntry  ScheduleEntry?
  smsMessages    SmsMessage[]
  notes          Note[]
  aiInteractions AIInteraction[]

  @@index([status, priority, createdAt])
  @@index([lat, lng])
}

// ── SCHEDULE ──

model ScheduleEntry {
  id           String         @id @default(cuid())
  technicianId String
  technician   Technician     @relation(fields: [technicianId], references: [id])
  jobId        String         @unique
  job          Job            @relation(fields: [jobId], references: [id])
  date         DateTime
  orderIndex   Int
  arrivalWindow String?
  notes        String?
  status       ScheduleStatus @default(SCHEDULED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([technicianId, date, orderIndex])
}

// ── SMS ──

model SmsMessage {
  id           String       @id @default(cuid())
  technicianId String?
  technician   Technician?  @relation(fields: [technicianId], references: [id])
  jobId        String?
  job          Job?         @relation(fields: [jobId], references: [id])
  direction    SmsDirection
  body         String
  aiDrafted    Boolean      @default(false)
  twilioSid    String?
  status       String?
  sentAt       DateTime?
  createdAt    DateTime     @default(now())
}

// ── CHAT ──

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String   @default("general")
  body      String
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
}

// ── NOTES ──

model Note {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  job         Job?     @relation(fields: [entityId], references: [id], map: "note_job_fk")
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// ── BOARD ──

enum BoardStatus {
  ASSIGNED
  EN_ROUTE
  ON_SITE
  WAITING
  PARTS
  PM
  DONE
  OUT
}

model BoardEntry {
  id           String       @id @default(cuid())
  technicianId String?
  technician   Technician?  @relation(fields: [technicianId], references: [id])
  manualName   String?
  date         DateTime     @db.Date
  assignment   String
  note         String?
  status       BoardStatus?
  orderIndex   Int          @default(0)
  isEmergency  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([date])
  @@unique([technicianId, date])
  @@unique([manualName, date])
}

// ── MANAGEMENT TASKS ──

enum MgmtTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model ManagementTask {
  id           String         @id @default(cuid())
  title        String
  notes        String?
  location     String?
  dueDate      DateTime?      @db.Date
  status       MgmtTaskStatus @default(OPEN)
  createdById  String
  createdBy    User           @relation("MgmtTasksCreated",  fields: [createdById],   references: [id])
  assignedToId String?
  assignedTo   User?          @relation("MgmtTasksAssigned", fields: [assignedToId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ── STORES / SERVICE LOCATIONS ──
// Each Store record represents a physical location Frost services.
// The `code` field is the 2–5 letter abbreviation that appears in the
// schedule board's assignment column (e.g. "WFM", "TGT"). When
// lat/lng are present the store appears as a teal pin on the Service Map.

model Store {
  id        String   @id @default(cuid())
  code      String   @unique  // schedule abbreviation (e.g. WFM, TGT)
  name      String
  address   String
  city      String?
  state     String?
  zip       String?
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── AI LOG ──

model AIInteraction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id])
  actionType   String
  prompt       String
  response     String
  feedback     String?  // "helpful" | "not_helpful"
  actualFix    String?
  issueSummary String?
  systemType   String?
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
